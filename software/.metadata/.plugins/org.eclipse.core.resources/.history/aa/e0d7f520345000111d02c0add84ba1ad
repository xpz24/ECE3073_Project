    IOWR(BUZZER_BASE, 0, NOTE_G4);  usleep(80000);
    IOWR(BUZZER_BASE, 0, NOTE_REST); usleep(20000);
    IOWR(BUZZER_BASE, 0, NOTE_C5);  usleep(80000);
