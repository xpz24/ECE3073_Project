void mario_theme(void)
{
    int notes[] = {
        NOTE_E5, NOTE_E5, NOTE_REST, NOTE_E5,
        NOTE_REST, NOTE_C5, NOTE_E5, NOTE_G5,
        NOTE_REST, NOTE_G4,

        NOTE_C5, NOTE_G4, NOTE_E4,
        NOTE_A4, NOTE_B4,
        NOTE_A4, NOTE_G4,

        NOTE_E5, NOTE_G5, NOTE_A5,
        NOTE_F5, NOTE_G5,

        NOTE_REST,
        NOTE_E5, NOTE_C5,
        NOTE_D5, NOTE_B4
    };

    int durations[] = {
        150, 150, 150, 150,
        150, 150, 150, 300,
        300, 300,

        300, 300, 300,
        150, 150,
        150, 150,

        150, 150, 300,
        150, 150,

        150,
        150, 150,
        150, 300
    };

    int length = sizeof(notes) / sizeof(notes[0]);

    for(int i = 0; i < length; i++)
    {
        IOWR(BUZZER_BASE, 0, notes[i]);

        usleep(durations[i] * 1000);

        // brief separation
        IOWR(BUZZER_BASE, 0, NOTE_REST);
        usleep(20000);
    }
}

