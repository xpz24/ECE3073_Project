#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "../project_M2_bsp/drivers/inc/altera_avalon_spi.h"
#include "../project_M2_bsp/HAL/inc/includes.h"
#include "../project_M2_bsp/system.h"
#include "../project_M2_bsp/HAL/inc/io.h"

// Task config
#define SPI_TASK_STACKSIZE  2048
#define SPI_TASK_PRIORITY   2
OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

// Peripherals
volatile int* OutPort_LEDR = (int*) 0x040090c0;
volatile int* PIO_KEY      = (int*) 0x040090e0;  // active-low buttons

// SDRAM
#define SDRAM_BASE   0x00000000
#define CAPTURE_LEN  64

volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// SPI command byte
#define CMD_CAPTURE  0x01

// Button 1: send capture command, store response in SDRAM
void handle_button1(void) {
    printf("[BTN1] Sending capture command to ESP32...\n");
    *OutPort_LEDR |= (1 << 0);   // LED0 on = busy

    uint8_t tx_buf[CAPTURE_LEN + 1];  // cmd byte + dummy clocks for response
    uint8_t rx_buf[CAPTURE_LEN + 1];

    memset(tx_buf, 0x00, sizeof(tx_buf));
    tx_buf[0] = CMD_CAPTURE;           // first byte is the command

    // alt_avalon_spi_command(base, slave, write_len, write_buf, read_len, read_buf, flags)
    // sends tx_buf[0] as command, then clocks in CAPTURE_LEN response bytes
    alt_avalon_spi_command(SPI_0_BASE, 0,
                           1,           tx_buf,   // write: 1 command byte
                           CAPTURE_LEN, rx_buf,   // read:  64 response bytes
                           0);

    // Store received bytes into SDRAM
    for (uint16_t i = 0; i < CAPTURE_LEN; i++) {
        sdram[i] = rx_buf[i];
    }

    printf("[BTN1] Stored %d bytes in SDRAM.\n", CAPTURE_LEN);
    printf("[BTN1] First byte received: 0x%02X\n", rx_buf[0]);

    *OutPort_LEDR &= ~(1 << 0);  // LED0 off
    *OutPort_LEDR |=  (1 << 1);  // LED1 on = data ready
}

// Button 2: read SDRAM and print all stored bytes
void handle_button2(void) {
    printf("[BTN2] Reading %d bytes from SDRAM...\n", CAPTURE_LEN);
    *OutPort_LEDR |= (1 << 2);

    for (uint16_t i = 0; i < CAPTURE_LEN; i++) {
        printf("  SDRAM[%3d] = 0x%02X  (%d)\n", i, sdram[i], sdram[i]);
    }

    printf("[BTN2] Read complete.\n");
    *OutPort_LEDR &= ~(1 << 2);
}

// spi task
void spi_task(void* pdata) {
    uint8_t prev_keys   = 0xF;
    uint8_t curr_keys;
    uint8_t btn1_handled = 0;
    uint8_t btn2_handled = 0;

    printf("[MAIN] Ready. KEY0 = capture to SDRAM, KEY1 = print from SDRAM.\n");

    while (1) {
        curr_keys = (uint8_t)(*PIO_KEY & 0xF);

        // KEY0 falling edge
        if (!(curr_keys & 0x1) && (prev_keys & 0x1) && !btn1_handled) {
            btn1_handled = 1;
            handle_button1();
        }
        if (curr_keys & 0x1) btn1_handled = 0;

        // KEY1 falling edge
        if (!(curr_keys & 0x2) && (prev_keys & 0x2) && !btn2_handled) {
            btn2_handled = 1;
            handle_button2();
        }
        if (curr_keys & 0x2) btn2_handled = 0;

        prev_keys = curr_keys;
        OSTimeDlyHMSM(0, 0, 0, 20);  // poll every 20ms
    }
}

// spi_init
void spi_init(void) {
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE - 1],
					SPI_TASK_PRIORITY,
					SPI_TASK_PRIORITY,
					spi_task_stk,
					SPI_TASK_STACKSIZE,
                    NULL,
                    0);
    OSStart();
}
