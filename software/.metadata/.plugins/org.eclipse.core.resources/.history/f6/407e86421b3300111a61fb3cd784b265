// write hex function
void write_hex(unsigned char s5, unsigned char s4, unsigned char s3,
               unsigned char s2, unsigned char s1, unsigned char s0) {
    IOWR_ALTERA_AVALON_PIO_DATA(HEX_LO_BASE,
        (s2 << 16) | (s1 << 8) | s0);
    IOWR_ALTERA_AVALON_PIO_DATA(HEX_HI_BASE,
        (s5 << 16) | (s4 << 8) | s3);
}

// clear hex function
void clear_hex() {
    write_hex(SEG_BLANK, SEG_BLANK, SEG_BLANK,
              SEG_BLANK, SEG_BLANK, SEG_BLANK);
}

// Display a number across HEX3..HEX0
void display_number(int num) {
    // Handle negative numbers
    int negative = 0;
    if (num < 0) { negative = 1; num = -num; }

    unsigned char seg_table[] = {
        SEG_0,SEG_1,SEG_2,SEG_3,SEG_4,
        SEG_5,SEG_6,SEG_7,SEG_8,SEG_9
    };

    unsigned char d0 = seg_table[num % 10];
    unsigned char d1 = seg_table[(num / 10)   % 10];
    unsigned char d2 = seg_table[(num / 100)  % 10];
    unsigned char d3 = seg_table[(num / 1000) % 10];
    unsigned char d4 = negative ? SEG_DASH : SEG_BLANK;

    IOWR_ALTERA_AVALON_PIO_DATA(HEX_LO_BASE,
        (d2 << 16) | (d1 << 8) | d0);
    IOWR_ALTERA_AVALON_PIO_DATA(HEX_HI_BASE,
        (SEG_BLANK << 16) | (d4 << 8) | d3);
}

// ================================================================
// SCROLL ENGINE
// Pass any string and it scrolls across all 6 HEX displays
// Returns 0 if SW[0] turned off mid-scroll, 1 if completed
// ================================================================
int scroll_string(char *text, int scroll_speed) {
    int len = 0;
    while (text[len] != '\0') len++;

    // Total scroll positions = message length + 6 blank lead-in
    int total = len + 6;
    int pos, j;

    for (pos = 0; pos < total; pos++) {
        unsigned char display[6];

        // Fill 6 display slots
        for (j = 0; j < 6; j++) {
            int char_idx = pos + j - 6;
            if (char_idx >= 0 && char_idx < len)
                display[j] = seg_char(text[char_idx]);
            else
                display[j] = SEG_BLANK;
        }

        // Write to displays (HEX5 is leftmost = display[5])
        write_hex(display[0], display[1], display[2],
                  display[3], display[4], display[5]);

        // Check if SW[0] turned off — abort scroll
        if (!(IORD_ALTERA_AVALON_PIO_DATA(SW_BASE) & 0x1)) {
            clear_hex();
            return 0;
        }

        // Scroll speed delay
        volatile int d;
        for (d = 0; d < scroll_speed; d++);
    }
    return 1;
}

// ================================================================
// MAIN
// ================================================================
int led_hex_main(void) {

    // Open accelerometer
    alt_up_accelerometer_spi_dev *accel;
    accel = alt_up_accelerometer_spi_open_dev("/dev/accelerometer_spi_0");
    if (!accel)
        printf("[ACCEL] Failed to open\n");
    else
        printf("[ACCEL] Ready\n");

    alt_32 x, y, z;
    int scroll_speed = 100000; // adjust to change scroll speed

    clear_hex();
    printf("System ready. Flip switches to display messages.\n");

    while (1) {
        int sw = IORD_ALTERA_AVALON_PIO_DATA(SW_BASE);

        // SW[0] OFF — everything off
        if (!(sw & 0x1)) {
            clear_hex();
            IOWR_ALTERA_AVALON_PIO_DATA(LEDR_BASE, 0x0);
        }

        // SW[0] ON — check other switches
        else {
            // Mirror switches to LEDs so you can see what's active
            IOWR_ALTERA_AVALON_PIO_DATA(LEDR_BASE, sw);

            // SW[0] + SW[9] — show live accelerometer on HEX
            if (sw & 0x200) {
                if (accel) {
                    alt_up_accelerometer_spi_read_x_axis(accel, &x);
                    alt_up_accelerometer_spi_read_y_axis(accel, &y);
                    alt_up_accelerometer_spi_read_z_axis(accel, &z);
                    printf("X=%ld Y=%ld Z=%ld\n", x, y, z);
                    // Show X axis value on HEX
                    display_number((int)x);
                }
            }

            // SW[0]+SW[1] — message 0: "HELLO"
            else if (sw & 0x2) {
                printf("Scrolling: %s\n", messages[0].text);
                scroll_string(messages[0].text, scroll_speed);
            }

            // SW[0]+SW[2] — message 1: "ACCEL"
            else if (sw & 0x4) {
                printf("Scrolling: %s\n", messages[1].text);
                scroll_string(messages[1].text, scroll_speed);
            }

            // SW[0]+SW[3] — message 2: "ECE3073"
            else if (sw & 0x8) {
                printf("Scrolling: %s\n", messages[2].text);
                scroll_string(messages[2].text, scroll_speed);
            }

            // SW[0]+SW[4] — message 3: "NIOS2"
            else if (sw & 0x10) {
                printf("Scrolling: %s\n", messages[3].text);
                scroll_string(messages[3].text, scroll_speed);
            }

            // SW[0]+SW[1]+SW[2] — message 4: "DE10 LITE"
            else if ((sw & 0x6) == 0x6) {
                printf("Scrolling: %s\n", messages[4].text);
                scroll_string(messages[4].text, scroll_speed);
            }

            // SW[0] only — default: scroll "HELLO"
            else {
                scroll_string(messages[0].text, scroll_speed);
            }
        }

        volatile int delay;
        for (delay = 0; delay < 10000; delay++);
    }

    return 0;
}
