// libraries
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "../M2_core3_bsp/HAL/inc/includes.h"
#include "../M2_core3_bsp/system.h"
#include "../M2_core3_bsp/HAL/inc/io.h"
#include "../M2_core3_bsp/drivers/inc/altera_avalon_spi_regs.h"   // for IORD/IOWR register macros
#include "../M2_core3_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../M2_core3_bsp/HAL/inc/sys/alt_irq.h"
#include "interrupts.h"

//  Task config
#define SPI_TASK_PRIORITY   2
#define SPI_TASK_STACKSIZE  2048
OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

//  Hardware addresses
#define SPI_BASE         CORE_3_SPI_BASE
#define SDRAM_BASE       SHARED_SDRAM_BASE
#define COUNTER_BASE     US_COUNTER_BASE
#define TX_3_1_BASE      CORE_3_1_TX_BASE
#define TX_3_2_BASE      CORE_3_2_TX_BASE

// TX flag definitions
#define TX_KEY0     0x1   /* bit 0: key 0, start capturing    */
#define TX_KEY1     0x2   /* bit 1: key 1, start displaying   */

// Protocol constants (must match ESP32)
#define CMD_TRIGGER_CAPTURE  0xA0
#define CMD_REQUEST_DATA     0xA1
#define CMD_ACK              0xAC
#define CMD_END              0xFF

// SPI word / payload sizing
// One SPI transaction = one 8-bit byte.
// We use 8-bit SPI mode (Avalon SPI configured for 8 bits).
#define CAPTURE_BUFFER_SIZE  256

// SDRAM pointer
volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// Static receive buffer
static uint8_t capture_buffer[CAPTURE_BUFFER_SIZE];

// read current microsecond count
static inline alt_u32 get_us(void) {
    return IORD_ALTERA_AVALON_PIO_DATA(COUNTER_BASE);
}

//  RTOS task
void spi_task(void* pdata)
{
	// Prime the SPI core — clear stale TX/RX state
	IOWR_ALTERA_AVALON_SPI_SLAVE_SEL(SPI_BASE, 0x1);
	IOWR_ALTERA_AVALON_SPI_TXDATA(SPI_BASE, 0x00);
	while (!(IORD_ALTERA_AVALON_SPI_STATUS(SPI_BASE) & 0x80));
	IORD_ALTERA_AVALON_SPI_RXDATA(SPI_BASE);  // clear RX
	IOWR_ALTERA_AVALON_SPI_SLAVE_SEL(SPI_BASE, 0x0);
    printf("ESP32 SPI COMMUNICATION TEST\n");
    printf("KEY0 - Test communication\n");
    printf("KEY1 - Request capture data\n");

    alt_u32 start = 0;
    alt_u32 end = 0;

    while (1) {
    	if (emergency_flag) {
    		printf("\n[SPI] EMERGENCY STOP - HALTING OPERATION\n");
			while (emergency_flag) {
				OSTimeDly(5);
			}
			key_flags = 0;
			printf("[SPI] EMERGENCY CLEARED - CONTINUING OPERATION\n");
    	}
		if (key_flags & (1 << 0)) {
			key_flags &= ~(1 << 0);
//			start = get_us();
//          test_communication();
//			end = get_us();
//			printf("\n[LATENCY] SPI capture data: %lu us\n\n", end - start);
			// notify core 1 key0 pressed
			start = get_us();
			tx_pulse(TX_3_1_BASE, TX_KEY0);
			end = get_us();
			printf("\n[LATENCY] Key0 to TX pulse: %lu us\n", end - start);
			// notify core 2 key0 pressed
			tx_pulse(TX_3_2_BASE, TX_KEY0);
		}
		if (key_flags & (1 << 1)) {
			key_flags &= ~(1 << 1);
//			start = get_us();
//          request_capture_data();
//			end = get_us();
//			printf("\n[LATENCY] SPI print data: %lu us\n\n", end - start);
			// notify core 1 key1 pressed
			start = get_us();
			tx_pulse(TX_3_1_BASE, TX_KEY1);
			end = get_us();
			printf("\n[LATENCY] Key1 to TX pulse: %lu us\n", end - start);
			// notify core 2 key1 pressed
			tx_pulse(TX_3_2_BASE, TX_KEY1);
		}
    	OSTimeDly(5);
    }

}

void spi_init(void)
{
	OSTaskCreateExt(spi_task,
					NULL,
					(void*)&spi_task_stk[SPI_TASK_STACKSIZE - 1],
					SPI_TASK_PRIORITY,
					SPI_TASK_PRIORITY,
					spi_task_stk,
					SPI_TASK_STACKSIZE,
					NULL,
					0);
}
