// libraries
#include <stdio.h>
#include <stdint.h>
#include "../project_M2_core1_bsp/HAL/inc/includes.h"
#include "../project_M2_core1_bsp/system.h"
#include "../project_M2_core1_bsp/HAL/inc/io.h"
#include "interrupts.h"

// STACK AND PRIORITY
#define SPI_TASK_PRIORITY  3
#define SPI_TASK_STACKSIZE 2048

OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

// PIN AND BASE ADDRESS DEFINITIONS
volatile int* SPI_RxData   = (int*) CORE_1_SPI_BASE; // receive data
volatile int* SPI_TxData   = (int*)(CORE_1_SPI_BASE + 4); // transmit data
volatile int* SPI_Status   = (int*)(CORE_1_SPI_BASE + 8); // status
volatile int* SPI_Control  = (int*)(CORE_1_SPI_BASE + 12); // control
volatile int* SPI_SS       = (int*) CORE_1_SPI_SS_BASE; // SPI SS from GPIO

// SDRAM STORAGE
#define SDRAM_BASE SHARED_SDRAM_BASE
#define MAX_PAYLOAD 256 // max 256 bytes per transfer
volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// MASKING
#define TRDY 0x40
#define RRDY 0x80

// PROTOCOL COMMANDS — must match ESP32 side
#define CMD_TRIGGER_CAPTURE 0xA0  // FPGA tells ESP32 to capture
#define CMD_REQUEST_DATA    0xA1
#define CMD_ACK             0xAC
#define CMD_READY           0xAD
#define CMD_END             0xFF

// SHARED RESULT BUFFER
static uint8_t  image_buf[MAX_PAYLOAD];
static uint16_t image_len = 0;
static volatile int new_data_ready = 0;  // flag for other tasks to read

// CS LOW
static void cs_low(void) {
    *SPI_SS = 0x0;
    for (volatile int d = 0; d < 500; d++);  // small setup delay
}

// CS HIGH
static void cs_high(void) {
    *SPI_SS = 0x1;
    for (volatile int d = 0; d < 500; d++);  // small hold delay
}

// REQUEST AND RECEIVE IMAGE DATA FROM ESP32
// Protocol:
//   1. FPGA pulls CS low, sends CMD_REQUEST_DATA
//   2. ESP32 responds with CMD_READY if data available, else CMD_ACK
//   3. FPGA sends CMD_ACK, ESP32 sends 2 bytes for length
//   4. FPGA receives length bytes of payload
//   5. FPGA sends CMD_END, CS high
int request_image_data(void) {
    uint8_t resp;
    uint16_t len;

    cs_low();

    // step 1 - send request
    resp = spi_transfer(CMD_REQUEST_DATA);

    // step 2 - check if ESP32 has data ready
    if (resp != CMD_READY) {
        cs_high();
        printf("[SPI] ESP32 not ready (0x%02X)\n", resp);
        return 0;
    }

    // step 3 - send ACK, receive length (2 bytes big endian)
    spi_transfer(CMD_ACK);
    uint8_t len_hi = spi_transfer(0x00);
    uint8_t len_lo = spi_transfer(0x00);
    len = ((uint16_t)len_hi << 8) | len_lo;

    if (len == 0 || len > MAX_PAYLOAD) {
        cs_high();
        printf("[SPI] Invalid length: %d\n", len);
        return 0;
    }

    // step 4 - receive payload
    printf("[SPI] Receiving %d bytes...\n", len);
    for (uint16_t i = 0; i < len; i++) {
        uint8_t byte = spi_transfer(0x00);  // send dummy, receive data
        image_buf[i] = byte;
        sdram[i] = byte;                    // store to SDRAM
    }
    image_len = len;

    // step 5 - end transfer
    spi_transfer(CMD_END);
    cs_high();

    printf("[SPI] Received %d bytes. First: 0x%02X\n", len, image_buf[0]);
    new_data_ready = 1;  // signal other tasks
    return 1;
}

// PRINT RECEIVED DATA
void print_image_data(void) {
    if (image_len == 0) {
        printf("[SPI] No data received yet.\n");
        return;
    }
    printf("[SPI] Image data (%d bytes):\n", image_len);
    for (uint16_t i = 0; i < image_len; i++) {
        printf("%02X ", image_buf[i]);
        if ((i + 1) % 16 == 0) printf("\n");
    }
    printf("\n");
}

// GET IMAGE BUFFER — for other tasks to read
uint8_t* get_image_buf(void) {
    return (uint8_t*)image_buf;
}

uint16_t get_image_len(void) {
    return image_len;
}

int is_new_data_ready(void) {
    return new_data_ready;
}

void clear_new_data_flag(void) {
    new_data_ready = 0;
}

// SPI TASK
void spi_task(void* pdata) {
    *SPI_SS = 0x1;  // CS high initially
    printf("[SPI] Task started.\n");
    printf("[SPI] KEY0 = capture | KEY1 = print data\n");

    while (1) {
    	// KEY0 - send trigger to ESP32 to capture image
		if (key_flags & (1 << 0)) {
			key_flags &= ~(1 << 0);
			printf("[KEY0] Sending capture trigger to ESP32.\n");
			cs_low();
			spi_transfer(CMD_TRIGGER_CAPTURE);
			cs_high();
		}

		// ESP32 ready interrupt - data is processed, now collect
		if (esp32_ready_flag) {
			esp32_ready_flag = 0;
			printf("[SPI] ESP32 ready, collecting data.\n");
			request_image_data();
		}

		// KEY1 - print stored data
		if (key_flags & (1 << 1)) {
			key_flags &= ~(1 << 1);
			print_image_data();
		}

        OSTimeDlyHMSM(0, 0, 0, 500);  // poll every 500ms
    }
}

// SPI INIT
void spi_init(void) {
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE-1],
                    SPI_TASK_PRIORITY,
                    SPI_TASK_PRIORITY,
                    spi_task_stk,
                    SPI_TASK_STACKSIZE,
                    NULL,
                    0);
}
