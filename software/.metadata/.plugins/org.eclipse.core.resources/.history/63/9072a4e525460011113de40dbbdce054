// libraries
#include <stdio.h>
#include "../project_M2_core1_bsp/system.h"
#include "../project_M2_core1_bsp/HAL/inc/alt_types.h"
#include "../project_M2_core1_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../project_M2_core1_bsp/drivers/inc/altera_up_avalon_accelerometer_spi.h"
#include "../project_M2_core1_bsp/HAL/inc/includes.h"
#include "../project_M2_core1_bsp/HAL/inc/io.h"

// definitions
#define ACCEL_PRIORITY    3
#define ACCEL_STACKSIZE   4096
OS_STK accel_stk[ACCEL_STACKSIZE];

// accel task
void accel_task(void* pdata) {
	alt_up_accelerometer_spi_dev *accel;
	alt_32 x, y, z;

	accel = alt_up_accelerometer_spi_open_dev("/dev/accelerometer_spi_0");

	if (!accel) {
		printf("[ACCEL] Failed to open device.\n");
		while (1);
	}
	else {
		printf("[ACCEL] Device initialized.\n");
	}

	// continuously read axis data
	while (1) {
		alt_up_accelerometer_spi_read_x_axis(accel, &x);
		alt_up_accelerometer_spi_read_y_axis(accel, &y);
		alt_up_accelerometer_spi_read_z_axis(accel, &z);

		printf("[ACCEL] X=%ld Y=%ld Z=%ld\n", x, y, z);

		OSTimeDlyHMSM(0, 0, 1, 0);
	}
}

// accel_init
void accel_init(void) {
    OSTaskCreateExt(accel_task,
                    NULL,
                    (void*)&accel_stk[ACCEL_STACKSIZE-1],
                    ACCEL_PRIORITY,
					ACCEL_PRIORITY,
                    accel_stk,
                    ACCEL_STACKSIZE,
                    NULL,
                    0);
}
