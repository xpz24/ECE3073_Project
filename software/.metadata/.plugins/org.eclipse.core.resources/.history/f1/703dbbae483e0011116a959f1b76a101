// libraries
#include <stdio.h>
#include <stdint.h>
#include "../project_M2_bsp/HAL/inc/includes.h"
#include "../project_M2_bsp/system.h"
#include "../project_M2_bsp/HAL/inc/io.h"

// STACK AND PRIORITY
#define SPI_TASK_STACKSIZE 1024
#define SPI_TASK_PRIORITY  2

OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

// PIN AND BASE ADDRESS DEFINITIONS
#define LED9 (1 << 9)
volatile int* OutPort_LEDR = (int*) 0x040090c0; // ledr
volatile int* SPI_RxData   = (int*) 0x04009020; // receive data
volatile int* SPI_TxData   = (int*) 0x04009024; // transmit data
volatile int* SPI_Status   = (int*) 0x04009028; // status
volatile int* SPI_Control  = (int*) 0x0400902c; // control

volatile int* SPI_SS       = (int*) 0x04009040; // SPI SS from GPIO

// MASKING
#define TRDY 0x40
#define RRDY 0x80

// SPI TASK
void spi_task(void* pdata) {
    uint8_t tx = 0x0;
    uint8_t rx = 0x0;

    // keep slave select off (active low)
    *SPI_SS = 0x1;
    printf("[SPI] START SPI\n");

    // turn led off - flag
    *OutPort_LEDR &= ~LED9;

    while (1) {
        // select spi slave
        *SPI_SS = 0x0;
        for (volatile int i = 0; i < 1000; i++); // small delay

        // wait for transmit ready
        while (!(*SPI_Status & TRDY));
        *SPI_TxData = tx;

        // wait for rx
        while (!(*SPI_Status & RRDY));
        rx = *SPI_RxData;
        printf("[SPI] Received: 0x%02X\n", rx);

        // deselect spi slave
        *SPI_SS = 0x1;

        // turn led9 off
        *OutPort_LEDR &= ~LED9;

        // delay 2 seconds
        OSTimeDlyHMSM(0, 0, 2, 0);

        // turn led9 on
        *OutPort_LEDR |= LED9;

        // increment data to be transmitted
//        tx++;

        // delay 2 seconds
//        OSTimeDlyHMSM(0, 0, 2, 0);
    }
}

// SPI INIT — call this from main before OSStart
void spi_init(void) {
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE-1],
                    SPI_TASK_PRIORITY,
                    SPI_TASK_PRIORITY,
                    spi_task_stk,
                    SPI_TASK_STACKSIZE,
                    NULL,
                    0);
}
