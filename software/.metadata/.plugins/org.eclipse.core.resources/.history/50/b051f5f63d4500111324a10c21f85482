// libraries
#include <stdio.h>
#include <stdint.h>
#include "../project_M2_core1_bsp/HAL/inc/includes.h"
#include "../project_M2_core1_bsp/system.h"
#include "../project_M2_core1_bsp/HAL/inc/io.h"

// STACK AND PRIORITY
#define SPI_TASK_PRIORITY  3
#define SPI_TASK_STACKSIZE 2048

OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

// PIN AND BASE ADDRESS DEFINITIONS
volatile int* SPI_RxData   = (int*) CORE_1_SPI_BASE; // receive data
volatile int* SPI_TxData   = (int*)(CORE_1_SPI_BASE + 4); // transmit data
volatile int* SPI_Status   = (int*)(CORE_1_SPI_BASE + 8); // status
volatile int* SPI_Control  = (int*)(CORE_1_SPI_BASE + 12); // control
volatile int* SPI_SS       = (int*) CORE_1_SPI_SS_BASE; // SPI SS from GPIO

// SDRAM STORAGE
#define SDRAM_BASE SHARED_SDRAM_BASE
#define MAX_PAYLOAD 256 // max 256 bytes per transfer
volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// MASKING
#define TRDY 0x40
#define RRDY 0x80

// PROTOCOL COMMANDS — must match ESP32 side
#define CMD_REQUEST_DATA  0xA1   // FPGA asks ESP32 for new image data
#define CMD_ACK           0xAC   // acknowledge
#define CMD_READY         0xAD   // ESP32 signals data is ready
#define CMD_END           0xFF   // end of transmission

// SHARED RESULT BUFFER
static uint8_t  image_buf[MAX_PAYLOAD];
static uint16_t image_len = 0;
static volatile int new_data_ready = 0;  // flag for other tasks to read

// capture spi data
void capture_spi_data(void) {
    uint8_t tx = 0x67;
    uint8_t rx = 0x00;

    printf("[KEY0] Capturing %d bytes...\n", CAPTURE_LEN);

    for (int i = 0; i < CAPTURE_LEN; i++) {

        *SPI_SS = 0x0;
        for (volatile int d = 0; d < 500; d++);

        while (!(*SPI_Status & TRDY));
        *SPI_TxData = tx;

        while (!(*SPI_Status & RRDY));
        rx = *SPI_RxData;

        sdram[i] = rx;

        *SPI_SS = 0x1;
        for (volatile int d = 0; d < 500; d++);
    }

    printf("[KEY0] Done. First byte: 0x%02X\n", sdram[0]);
}

// print sdram
void print_sdram(void) {
    printf("[KEY1] Reading SDRAM...\n");

    for (int i = 0; i < CAPTURE_LEN; i++) {
        printf("SDRAM[%02d] = 0x%02X\n", i, sdram[i]);
    }

    printf("[KEY1] Done.\n");
}

// SPI TASK
void spi_task(void* pdata) {
    uint8_t prev = 0xF;
    uint8_t curr;

    *SPI_SS = 0x1;
    printf("[SYSTEM] KEY0 = capture | KEY1 = print\n");

    while (1) {
        curr = (uint8_t)(*PIO_KEY & 0xF);

        // KEY0 pressed (capture)
        if (!(curr & 0x1) && (prev & 0x1)) {
            capture_spi_data();
        }

        // KEY1 pressed (print)
        if (!(curr & 0x2) && (prev & 0x2)) {
            print_sdram();
        }

        prev = curr;

        OSTimeDlyHMSM(0, 0, 0, 50); // debounce
    }
}

// SPI INIT — call this from main before OSStart
void spi_init(void) {
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE-1],
                    SPI_TASK_PRIORITY,
                    SPI_TASK_PRIORITY,
                    spi_task_stk,
                    SPI_TASK_STACKSIZE,
                    NULL,
                    0);
}
