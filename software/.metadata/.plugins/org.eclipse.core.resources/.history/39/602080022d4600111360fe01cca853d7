// libraries
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "../M2_core1_bsp/HAL/inc/includes.h"
#include "../M2_core1_bsp/system.h"
#include "../M2_core1_bsp/HAL/inc/io.h"
#include "interrupts.h"
#include "../M2_core1_bsp/drivers/inc/altera_avalon_spi_regs.h"   // for IORD/IOWR register macros

//  Task config
#define SPI_TASK_PRIORITY   3
#define SPI_TASK_STACKSIZE  2048
OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

//  Hardware addresses
#define SPI_BASE         CORE_1_SPI_BASE
#define SDRAM_BASE       SHARED_SDRAM_BASE

// Protocol constants (must match ESP32)
#define CMD_TRIGGER_CAPTURE  0xA0
#define CMD_REQUEST_DATA     0xA1
#define CMD_ACK              0xAC
#define CMD_END              0xFF

// SPI word / payload sizing
// One SPI transaction = one 8-bit byte.
// We use 8-bit SPI mode (Avalon SPI configured for 8 bits).
#define CAPTURE_BUFFER_SIZE  256

// SDRAM pointer
volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// Static receive buffer
static uint8_t capture_buffer[CAPTURE_BUFFER_SIZE];

//  Low-level SPI helpers  (mirror your friend's register-bang style)

/* Assert SS_N (CS low) and enable software SS override */
static inline void spi_cs_assert(void)
{
    IOWR_ALTERA_AVALON_SPI_CONTROL(SPI_BASE, 0x400);  // set SSO bit
    IOWR_ALTERA_AVALON_SPI_SLAVE_SEL(SPI_BASE, 0x1);  // select slave 0
}

/* De-assert SS_N and clear override */
static inline void spi_cs_deassert(void)
{
    IOWR_ALTERA_AVALON_SPI_SLAVE_SEL(SPI_BASE, 0x0);
    IOWR_ALTERA_AVALON_SPI_CONTROL(SPI_BASE, 0x000);  // clear SSO bit
}

/*
 * Transfer one byte: wait for TRDY, write TX, wait for RRDY, read RX.
 * CS must already be asserted before calling this.
 */
static uint8_t spi_transfer_byte(uint8_t tx)
{
    // Wait for transmit-ready
    while (!(IORD_ALTERA_AVALON_SPI_STATUS(SPI_BASE) & 0x40));
    IOWR_ALTERA_AVALON_SPI_TXDATA(SPI_BASE, tx);

    // Wait for receive-ready
    while (!(IORD_ALTERA_AVALON_SPI_STATUS(SPI_BASE) & 0x80));
    return (uint8_t) IORD_ALTERA_AVALON_SPI_RXDATA(SPI_BASE);
}

/*
 * Small delay — give ESP32 time to re-queue its DMA buffer between
 * back-to-back transactions.  Tune this if you see mis-framing.
 */
static inline void spi_inter_transaction_delay(void)
{
	OSTimeDly(50);
}

//  Protocol helpers

/*
 * Send one command byte and receive one response byte in a single CS pulse.
 * Returns 1 if response == expected_response, 0 otherwise.
 */
static int send_command(uint8_t cmd, uint8_t expected_response)
{
    uint8_t response;

    spi_cs_assert();
    response = spi_transfer_byte(cmd);
    spi_cs_deassert();
    spi_inter_transaction_delay();          // let ESP32 re-queue

    if (response != expected_response) {
        printf("[SPI] CMD 0x%02X: expected 0x%02X, got 0x%02X\n",
               cmd, expected_response, response);
        return 0;
    }
    return 1;
}

/*
 * Read `length` bytes from the ESP32 into `buf`.
 * Each byte is its own CS-asserted transaction so the ESP32 slave
 * can queue one byte at a time — matching how ESP32SPISlave works.
 */
static int spi_read_bytes(uint8_t *buf, uint16_t length)
{
    for (uint16_t i = 0; i < length; i++) {
        spi_cs_assert();
        buf[i] = spi_transfer_byte(0x00);   // dummy TX
        spi_cs_deassert();
        spi_inter_transaction_delay();
    }
    return 0;
}

//  Application-level functions

static void request_capture_data(void)
{
    uint8_t len_bytes[2];
    uint16_t data_length;
    uint8_t end_marker;
    uint16_t i;

    printf("\n========== CAPTURE DATA REQUEST ==========\n");

    // Step 1: trigger capture, expect ACK
    if (!send_command(CMD_TRIGGER_CAPTURE, CMD_ACK)) {
        printf("[SPI] Trigger capture failed\n");
        printf("==========================================\n");
        return;
    }
    printf("[SPI] ESP32 acknowledged capture trigger\n");

    OSTimeDly(10);   // give ESP32 time to capture

    // Step 2: send REQUEST_DATA command
    //    ESP32 queues the ACK/length in response to this byte;
    //    we discard the response here because ESP32 sends length next.
    spi_cs_assert();
    spi_transfer_byte(CMD_REQUEST_DATA);    // response byte is don't-care
    spi_cs_deassert();
    spi_inter_transaction_delay();

    // Step 3: read 2-byte length (little-endian)
    if (spi_read_bytes(len_bytes, 2) != 0) {
        printf("[SPI] Failed to read length\n");
        return;
    }
    data_length = (uint16_t)(len_bytes[0]) | ((uint16_t)(len_bytes[1]) << 8);
    printf("[SPI] Data length: %d bytes\n", data_length);

    if (data_length == 0 || data_length > CAPTURE_BUFFER_SIZE) {
        printf("[SPI] Invalid data length: %d\n", data_length);
        return;
    }

    // Step 4: read payload
    printf("[SPI] Receiving %d bytes...\n", data_length);
    if (spi_read_bytes(capture_buffer, data_length) != 0) {
        printf("[SPI] Failed to read payload\n");
        return;
    }

    // Step 5: read end marker
    if (spi_read_bytes(&end_marker, 1) != 0) {
        printf("[SPI] Failed to read end marker\n");
        return;
    }

    if (end_marker != CMD_END) {
        printf("[SPI] Bad end marker: 0x%02X\n", end_marker);
        return;
    }

    printf("[SPI] Successfully received %d bytes\n", data_length);

    // Print first 16 bytes
    printf("[SPI] First 16 bytes: ");
    uint16_t show = (data_length > 16) ? 16 : data_length;
    for (i = 0; i < show; i++) {
        printf("%02X ", capture_buffer[i]);
    }
    printf("\n");

    // Store to SDRAM
    for (i = 0; i < data_length; i++) {
        sdram[i] = capture_buffer[i];
    }
    printf("[SPI] Data saved to SDRAM\n");
    printf("==========================================\n");
}

static void test_communication(void)
{
    uint8_t test_values[] = {0x55, 0xAA, 0xA0, 0xAC};
    uint8_t response;
    int success = 0;

    printf("\n========== SPI TEST ==========\n");

    for (int i = 0; i < 4; i++) {
        spi_cs_assert();
        response = spi_transfer_byte(test_values[i]);
        spi_cs_deassert();
        spi_inter_transaction_delay();

        printf("Sent: 0x%02X, Received: 0x%02X", test_values[i], response);
        if (response == test_values[i]) {
            printf(" [OK]\n");
            success++;
        } else {
            printf(" [FAIL]\n");
        }
        OSTimeDly(10);
    }

    printf("\nResult: %d/4 successful\n", success);
    printf(success == 4 ? "Communication is WORKING\n"
                        : "Communication FAILED\n");
    printf("==============================\n");
}

//  RTOS task

void spi_task(void* pdata)
{
    printf("\n========================================\n");
    printf("ESP32 SPI COMMUNICATION TEST\n");
    printf("========================================\n");
    printf("KEY0 - Test communication\n");
    printf("KEY1 - Request capture data\n");
    printf("========================================\n\n");
    printf("Ready for commands...\n\n");

    while (1) {
        if (key_flags & (1 << 0)) {
        	printf("key0 pressed\n");
            key_flags &= ~(1 << 0);
            test_communication();
        }
        if (key_flags & (1 << 1)) {
            key_flags &= ~(1 << 1);
            request_capture_data();
        }
        OSTimeDly(10);
    }

}

void spi_init(void)
{
	OSTaskCreateExt(spi_task,
					NULL,
					(void*)&spi_task_stk[SPI_TASK_STACKSIZE - 1],
					SPI_TASK_PRIORITY,
					SPI_TASK_PRIORITY,
					spi_task_stk,
					SPI_TASK_STACKSIZE,
					NULL,
					0);
}
