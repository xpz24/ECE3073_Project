// STACK AND PRIORITY
#define SPI_TASK_PRIORITY  3
#define SPI_TASK_STACKSIZE 2048

OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

// PIN AND BASE ADDRESS DEFINITIONS - FIXED for 16-bit Avalon SPI
volatile uint16_t* SPI_RxData   = (uint16_t*)(CORE_1_SPI_BASE + 0);   // receive data
volatile uint16_t* SPI_TxData   = (uint16_t*)(CORE_1_SPI_BASE + 2);   // transmit data
volatile uint16_t* SPI_Status   = (uint16_t*)(CORE_1_SPI_BASE + 4);   // status
volatile uint16_t* SPI_Control  = (uint16_t*)(CORE_1_SPI_BASE + 6);   // control
volatile uint8_t*  SPI_SS       = (uint8_t*) CORE_1_SPI_SS_BASE;      // SPI SS from GPIO

// SDRAM STORAGE
#define SDRAM_BASE SHARED_SDRAM_BASE
#define MAX_PAYLOAD 256
volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// PROTOCOL COMMANDS
#define CMD_TRIGGER_CAPTURE 0xA0
#define CMD_REQUEST_DATA    0xA1
#define CMD_ACK             0xAC
#define CMD_READY           0xAD
#define CMD_END             0xFF

#define CAPTURE_BUFFER_SIZE 256

static uint8_t capture_buffer[CAPTURE_BUFFER_SIZE];
static uint16_t capture_index = 0;

// CS LOW/HIGH
static void cs_low(void) {
    *SPI_SS = 0x0;
}

static void cs_high(void) {
    *SPI_SS = 0x1;
}

// SPI transfer for 16-bit Avalon SPI
static uint8_t spi_transfer(uint8_t tx) {
    // Write 8-bit data to 16-bit register
    *SPI_TxData = (uint16_t)tx;

    // Wait for receive ready (RRDY bit 6)
    int timeout = 1000000;
    while (!((*SPI_Status) & (1 << 6))) {
        if (--timeout == 0) {
            printf("Timeout - Status: 0x%04X\n", *SPI_Status);
            return 0xEE;
        }
    }

    // Read 16-bit and mask to 8-bit
    return (uint8_t)(*SPI_RxData);
}

// Send command and wait for response
static uint8_t send_command(uint8_t cmd, uint8_t expected_response) {
    uint8_t response;

    cs_low();
    for (volatile int d = 0; d < 100; d++);
    response = spi_transfer(cmd);
    cs_high();

    if (response != expected_response) {
        printf("[SPI] Command 0x%02X failed. Got 0x%02X, expected 0x%02X\n",
               cmd, response, expected_response);
        return 0;
    }
    return 1;
}

// Request captured data from ESP32
static void request_capture_data(void) {
    uint8_t response;
    uint16_t data_length;
    uint16_t i;

    printf("\n========== CAPTURE DATA REQUEST ==========\n");
    printf("[SPI] Requesting capture data from ESP32...\n");

    // Step 1: Send TRIGGER CAPTURE command
    if (!send_command(CMD_TRIGGER_CAPTURE, CMD_ACK)) {
        printf("[SPI] Trigger capture failed\n");
        printf("==========================================\n");
        return;
    }
    printf("[SPI] ESP32 acknowledged capture trigger\n");

    // Small delay for ESP32 to capture
    OSTimeDly(10);

    // Step 2: Request the captured data
    printf("[SPI] Requesting data...\n");
    cs_low();
    for (volatile int d = 0; d < 100; d++);
    spi_transfer(CMD_REQUEST_DATA);

    // Step 3: Read data length (2 bytes, little-endian)
    uint8_t len_low = spi_transfer(0x00);
    uint8_t len_high = spi_transfer(0x00);
    data_length = (len_high << 8) | len_low;
    printf("[SPI] Data length: %d bytes\n", data_length);

    if (data_length > 0 && data_length <= CAPTURE_BUFFER_SIZE) {
        printf("[SPI] Receiving %d bytes...\n", data_length);
        printf("[SPI] Data: ");

        // Read the actual data
        for (i = 0; i < data_length && i < 32; i++) {
            capture_buffer[i] = spi_transfer(0x00);
            printf("%02X ", capture_buffer[i]);
        }
        if (data_length > 32) printf("...");
        printf("\n");

        // Read end marker
        uint8_t end = spi_transfer(0x00);
        cs_high();

        if (end == CMD_END) {
            printf("[SPI] Successfully received %d bytes\n", data_length);

            // Store to SDRAM
            for (i = 0; i < data_length; i++) {
                sdram[i] = capture_buffer[i];
            }
            printf("[SPI] Data saved to SDRAM\n");
        } else {
            printf("[SPI] Expected END marker, got 0x%02X\n", end);
        }
    } else {
        cs_high();
        printf("[SPI] Invalid data length: %d\n", data_length);
    }
    printf("==========================================\n");
}

// Test communication
static void test_communication(void) {
    uint8_t test_values[] = {0x55, 0xAA, 0xA0, 0xAC};
    int success = 0;

    printf("\n========== SPI TEST ==========\n");
    printf("Status Register: 0x%04X\n", *SPI_Status);
    printf("Control Register: 0x%04X\n\n", *SPI_Control);

    for (int i = 0; i < 4; i++) {
        cs_low();
        for (volatile int d = 0; d < 100; d++);
        uint8_t response = spi_transfer(test_values[i]);
        cs_high();

        printf("Sent: 0x%02X, Received: 0x%02X", test_values[i], response);
        if (response == test_values[i]) {
            printf(" correct\n");
            success++;
        } else {
            printf(" wrong\n");
        }
        OSTimeDly(10);
    }

    printf("\nResult: %d/4 successful\n", success);
    printf("==============================\n");
}

// Debug registers
static void debug_registers(void) {
    printf("\n========== REGISTER DEBUG ==========\n");
    printf("CORE_1_SPI_BASE: 0x%08X\n", CORE_1_SPI_BASE);
    printf("SPI Control:     0x%04X\n", *SPI_Control);
    printf("SPI Status:      0x%04X\n", *SPI_Status);
    printf("SPI RxData:      0x%04X\n", *SPI_RxData);
    printf("SPI TxData:      0x%04X\n", *SPI_TxData);
    printf("SPI SS:          0x%02X\n", *SPI_SS);
    printf("====================================\n");
}

// SPI TASK
void spi_task(void* pdata) {
    *SPI_SS = 0x1;

    printf("\n========================================\n");
    printf("ESP32 SPI COMMUNICATION TEST\n");
    printf("========================================\n");
    printf("KEY0 - Test communication\n");
    printf("KEY1 - Request capture data\n");
    printf("KEY2 - Debug registers\n");
    printf("========================================\n\n");

    // Show initial register values
    debug_registers();

    printf("Ready for commands...\n\n");

    while (1) {
        // KEY0 - Test communication
        if (key_flags & (1 << 0)) {
            key_flags &= ~(1 << 0);
            test_communication();
        }

        // KEY1 - Request capture data
        if (key_flags & (1 << 1)) {
            key_flags &= ~(1 << 1);
            request_capture_data();
        }

        // KEY2 - Debug registers (if you have a third key)
        if (key_flags & (1 << 2)) {
            key_flags &= ~(1 << 2);
            debug_registers();
        }

        OSTimeDly(1);
    }
}

// SPI initialization for Avalon SPI
void spi_init_hardware(void) {
    printf("[SPI] Initializing Avalon SPI...\n");

    // Reset control register
    *SPI_Control = 0x0000;

    // Configure SPI from system.h settings
    uint16_t control = 0;

    // Set clock polarity and phase (from system.h)
    // CORE_1_SPI_CLOCKPOLARITY = 0, CORE_1_SPI_CLOCKPHASE = 0
    control |= (0 << 0);  // CPOL (bit 0)
    control |= (0 << 1);  // CPHA (bit 1)

    // Set as master (from system.h: CORE_1_SPI_ISMASTER = 1)
    control |= (1 << 2);  // Master mode (bit 2)

    // Set data width (8 bits)
    control |= (7 << 3);  // Data width = 8 bits (bits 3-5: 0-7 for 8 bits)

    // Clear SSO (Slave Select Output) - we control CS manually
    control &= ~(1 << 6);

    // Enable SPI
    control |= (1 << 7);  // Enable (bit 7)

    *SPI_Control = control;

    printf("[SPI] Control: 0x%04X, Status: 0x%04X\n",
           *SPI_Control, *SPI_Status);
}

// SPI INIT
void spi_init(void) {
    spi_init_hardware();
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE-1],
                    SPI_TASK_PRIORITY,
                    SPI_TASK_PRIORITY,
                    spi_task_stk,
                    SPI_TASK_STACKSIZE,
                    NULL,
                    0);
}
