// Fix your SPI initialization - ensure correct mode
void spi_init_hardware(void) {
    // Assuming you have an SPI controller at CORE_1_SPI_BASE
    // Configure for MODE0 (CPOL=0, CPHA=0)

    // Example configuration (adjust registers based on your SPI controller):
    // *SPI_Control = 0x00;  // Disable first
    // Configure clock divider, mode, etc.
    *SPI_Control |= (0 << 2);  // CPHA = 0
    *SPI_Control |= (0 << 3);  // CPOL = 0
    // Set clock rate (e.g., 1MHz)
    // *SPI_ClockDivider = some_value;
    // Enable SPI
    // *SPI_Control |= 0x01;
}

// SPI INIT
void spi_init(void) {
	spi_init_hardware();
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE-1],
                    SPI_TASK_PRIORITY,
                    SPI_TASK_PRIORITY,
                    spi_task_stk,
                    SPI_TASK_STACKSIZE,
                    NULL,
                    0);
}
