// STACK AND PRIORITY
#define SPI_TASK_PRIORITY  3
#define SPI_TASK_STACKSIZE 2048

OS_STK spi_task_stk[SPI_TASK_STACKSIZE];

// PIN AND BASE ADDRESS DEFINITIONS
volatile int* SPI_RxData   = (int*) CORE_1_SPI_BASE; // receive data
volatile int* SPI_TxData   = (int*)(CORE_1_SPI_BASE + 4); // transmit data
volatile int* SPI_Status   = (int*)(CORE_1_SPI_BASE + 8); // status
volatile int* SPI_Control  = (int*)(CORE_1_SPI_BASE + 12); // control
volatile int* SPI_SS       = (int*) CORE_1_SPI_SS_BASE; // SPI SS from GPIO

// SDRAM STORAGE
#define SDRAM_BASE SHARED_SDRAM_BASE
#define MAX_PAYLOAD 256 // max 256 bytes per transfer
volatile uint8_t* sdram = (volatile uint8_t*) SDRAM_BASE;

// MASKING
#define TRDY 0x40
#define RRDY 0x80

// PROTOCOL COMMANDS — must match ESP32 side
#define CMD_TRIGGER_CAPTURE 0xA0  // FPGA tells ESP32 to capture
#define CMD_REQUEST_DATA    0xA1
#define CMD_ACK             0xAC
#define CMD_READY           0xAD
#define CMD_END             0xFF

// CS LOW
static void cs_low(void) {
    *SPI_SS = 0x0;
}

// CS HIGH
static void cs_high(void) {
    *SPI_SS = 0x1;
}

static uint8_t spi_transfer(uint8_t tx) {
    int timeout;

    // Clear any pending status bits
    uint32_t status = *SPI_Status;

    // Wait for TX ready with longer timeout
    timeout = 10000000;  // Increased timeout
    while (!(*SPI_Status & TRDY)) {
        if (--timeout == 0) {
            printf("[ERROR] TRDY timeout. Status=0x%02X\n", *SPI_Status);
            return 0xEE;
        }
    }

    // Write data
    *SPI_TxData = tx;
    printf("[DEBUG] TX=0x%02X written\n", tx);

    // Wait for RX ready
    timeout = 10000000;
    while (!(*SPI_Status & RRDY)) {
        if (--timeout == 0) {
            printf("[ERROR] RRDY timeout. Status=0x%02X\n", *SPI_Status);
            return 0xEE;
        }
    }

    uint8_t rx = (uint8_t)(*SPI_RxData);
    printf("[DEBUG] RX=0x%02X read\n", rx);

    return rx;
}

void simple_spi_test(void) {
    printf("[TEST] Starting SPI loopback test\n");

    while (1) {
        uint8_t rx;

        cs_low();
        for (volatile int d = 0; d < 1000; d++);

        rx = spi_transfer(0xAA);

        cs_high();

        printf("[FPGA] Sent 0xAA, Received 0x%02X %s\n",
               rx, (rx == 0xAA) ? "PASS" : "FAIL");

        OSTimeDly(50);
    }
}

