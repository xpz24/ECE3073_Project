// vga_text_render.h
// Rendering functions for VGA text display.
// Depends on vga_text.h (font, layout constants, ticker buffer)
// and your existing write_pixel() function.

#ifndef VGA_TEXT_RENDER_H
#define VGA_TEXT_RENDER_H

#include "vga_text.h"

//  Forward declaration - already in vga.c
extern void write_pixel(unsigned int addr, uint16_t color);

//  SCROLL STATE
//  tilt_scroll_offset > 0  -->  user is browsing history
//  tilt_scroll_offset == 0 -->  live mode, auto-follows newest
static int tilt_scroll_offset = 0;

//  MAIN PANEL LAYOUT
//
//  We show MAIN_CHARS characters across the main panel at scale 2.
//  slot_w = FONT_W * 2 + 2  (1px gap each side)
//  The highlighted (viewed) character is always centred.
//
//  Example with MAIN_CHARS = 9 and viewed in the middle (index 4):
//
//   [ A ][ B ][ C ][ D ][*E*][ F ][ G ][ H ][ I ]
//                              ^--- viewed_idx, drawn in accent colour
//
//  When not tilting, viewed_idx = ticker.count - 1 (newest), so the
//  newest char is always centred and history trails off to the left.
#define MAIN_SCALE    2
#define MAIN_SLOT_W   (FONT_W * MAIN_SCALE + 2)
#define MAIN_CHARS    ((PANEL_SPLIT / MAIN_SLOT_W) | 1)   // force odd so centre exists

//  Low-level primitives
static void fill_rect(int x, int y, int w, int h, uint16_t color) {
    int px, py;
    for (py = y; py < y + h; py++)
        for (px = x; px < x + w; px++)
            if (px >= 0 && px < FB_WIDTH && py >= 0 && py < FB_HEIGHT)
                write_pixel(py * FB_WIDTH + px, color);
}

static void draw_char(char c, int x, int y, int scale, uint16_t fg, uint16_t bg) {
    int idx = font_index(c);
    int row, col;
    for (row = 0; row < FONT_H; row++) {
        uint8_t bits = font8x12[idx][row];
        for (col = 0; col < FONT_W; col++) {
            uint16_t color = (bits & (0x80 >> col)) ? fg : bg;
            fill_rect(x + col * scale, y + row * scale, scale, scale, color);
        }
    }
}

static void draw_string(const char *s, int x, int y, int scale, uint16_t fg, uint16_t bg) {
    int cx = x;
    while (*s) {
        draw_char(*s, cx, y, scale, fg, bg);
        cx += FONT_W * scale + scale;
        s++;
    }
}

//  draw_main_panel()
//
//  Draws MAIN_CHARS characters centred around viewed_idx.
//  The viewed character is drawn large (scale 3) in the centre;
//  neighbours are drawn at scale 2, dimmed.
//  A highlight box sits behind the centre character.
static void draw_main_panel(int viewed_idx) {
    fill_rect(0, 0, PANEL_SPLIT, MAIN_AREA_H, COL_BG);

    if (tilt_scroll_offset == 0)
        draw_string("DETECTED:", 8, 8, 1, COL_LABEL, COL_BG);
    else
        draw_string("HISTORY: ", 8, 8, 1, COL_LABEL, COL_BG);
    fill_rect(8, 20, PANEL_SPLIT - 16, 1, COL_DIVIDER);

    if (ticker.count == 0) {
        draw_char(' ', (PANEL_SPLIT - FONT_W * 3) / 2,
                  (MAIN_AREA_H - FONT_H * 3) / 2 - 10, 3, COL_ACCENT, COL_BG);
        return;
    }

    int half    = MAIN_CHARS / 2;
    int total_w = MAIN_CHARS * MAIN_SLOT_W;
    int start_x = (PANEL_SPLIT - total_w) / 2;

    // precompute centre char geometry - everything aligns to this
    int big_w     = FONT_W * MAIN_SCALE;
    int big_h     = FONT_H * MAIN_SCALE;
    int big_x     = (PANEL_SPLIT - big_w) / 2;
    int big_y     = MAIN_AREA_H / 2 - big_h / 2;

    // draw highlight box FIRST before any chars
    fill_rect(big_x, big_y - 4, big_w + 4, big_h + 4, COL_DIVIDER);

    int i;
    for (i = -half; i <= half; i++) {
        int ticker_idx = viewed_idx + i;
        int slot_x     = start_x + (i + half) * MAIN_SLOT_W;

        char c;
        if (ticker_idx < 0 || ticker_idx >= ticker.count)
            c = ' ';
        else
            c = ticker_get(ticker_idx);

        if (i == 0) {
            draw_char(c, big_x, big_y, MAIN_SCALE, COL_ACCENT, COL_DIVIDER);
        } else {
            // vertically centre neighbours against the big char
            int neighbour_y = big_y;
            uint16_t fg = (i >= -1 && i <= 1) ? COL_TICKER_FG : COL_LABEL;
            draw_char(c, slot_x, neighbour_y, MAIN_SCALE, fg, COL_BG);
        }
    }

    if (tilt_scroll_offset > 0) {
        draw_string("BACK:", 8, MAIN_AREA_H - 20, 1, COL_LABEL, COL_BG);
        char tens = '0' + (tilt_scroll_offset / 10);
        char ones = '0' + (tilt_scroll_offset % 10);
        if (tilt_scroll_offset >= 10) {
            draw_char(tens, 48,              MAIN_AREA_H - 20, 1, COL_ACCENT, COL_BG);
            draw_char(ones, 48 + FONT_W + 1, MAIN_AREA_H - 20, 1, COL_ACCENT, COL_BG);
        } else {
            draw_char(ones, 48, MAIN_AREA_H - 20, 1, COL_ACCENT, COL_BG);
        }
    } else {
        draw_string("LATEST", 8, MAIN_AREA_H - 20, 1, COL_LABEL, COL_BG);
    }
}


//  draw_ticker()
//
//  Bottom strip - small chars, highlight follows tilt_scroll_offset.
static void draw_ticker(void) {
    fill_rect(0, MAIN_AREA_H, FB_WIDTH, TICKER_HEIGHT, COL_TICKER_BG);
    fill_rect(0, MAIN_AREA_H, FB_WIDTH, 1, COL_DIVIDER);

    int slot_w       = FONT_W * 2 + 3;
    int max_visible  = FB_WIDTH / slot_w;
    int start        = ticker.count > max_visible ? ticker.count - max_visible : 0;
    int cx           = 2;
    int cy           = MAIN_AREA_H + (TICKER_HEIGHT - FONT_H * 2) / 2;
    int viewed_idx   = (ticker.count - 1) - tilt_scroll_offset;
    int i;

    for (i = start; i < ticker.count; i++) {
        char c        = ticker_get(i);
        int is_viewed = (i == viewed_idx);
        uint16_t fg   = is_viewed ? COL_ACCENT    : COL_TICKER_FG;
        uint16_t bg   = is_viewed ? COL_DIVIDER   : COL_TICKER_BG;

        if (is_viewed)
            fill_rect(cx - 1, cy - 4, FONT_W * 2 + 2, FONT_H * 2 + 4, COL_DIVIDER);

        draw_char(c, cx, cy, 2, fg, bg);
        cx += slot_w;
    }
}

//  Public API

// Call once on KEY1 / startup
static void vga_text_init(void) {
    ticker_init();
    tilt_scroll_offset = 0;
    fill_rect(0, 0, FB_WIDTH, FB_HEIGHT, COL_BG);
    draw_main_panel(0);
    draw_ticker();
}

// Call every time Grove AI sends a new character.
// In live mode (offset==0) the view auto-follows newest.
static void vga_text_update(char new_char) {
    ticker_push(new_char);
    int viewed_idx = (ticker.count - 1) - tilt_scroll_offset;
    draw_main_panel(viewed_idx);
    draw_ticker();
}

// Tilt scroll - call with direction = +1 (go back) or -1 (go forward/newer)
static void vga_tilt_scroll(int direction) {
    int new_offset = tilt_scroll_offset - direction;
    if (new_offset < 0)                  new_offset = 0;
    if (new_offset >= ticker.count)      new_offset = ticker.count - 1;
    if (new_offset == tilt_scroll_offset) return;   // already at boundary

    tilt_scroll_offset = new_offset;
    int viewed_idx = (ticker.count - 1) - tilt_scroll_offset;
    if (viewed_idx < 0) viewed_idx = 0;
    draw_main_panel(viewed_idx);
    draw_ticker();
}

// Hard reset - snap back to latest (KEY0 clear or explicit reset)
static void vga_tilt_reset(void) {
    tilt_scroll_offset = 0;
    int viewed_idx = ticker.count > 0 ? ticker.count - 1 : 0;
    draw_main_panel(viewed_idx);
    draw_ticker();
}

#endif // VGA_TEXT_RENDER_H
