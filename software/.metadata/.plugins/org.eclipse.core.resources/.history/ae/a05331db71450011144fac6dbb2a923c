// SPI INIT
void spi_init(void) {
    OSTaskCreateExt(spi_task,
                    NULL,
                    (void*)&spi_task_stk[SPI_TASK_STACKSIZE-1],
                    SPI_TASK_PRIORITY,
                    SPI_TASK_PRIORITY,
                    spi_task_stk,
                    SPI_TASK_STACKSIZE,
                    NULL,
                    0);
}
