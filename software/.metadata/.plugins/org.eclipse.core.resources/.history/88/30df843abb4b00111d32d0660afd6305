// Maps a char to font table index. Returns 0 (space) if unsupported.
static inline int font_index(char c) {
    if (c >= '0' && c <= '9') return 1 + (c - '0');
    if (c >= 'A' && c <= 'Z') return 11 + (c - 'A');
    if (c >= 'a' && c <= 'z') return 11 + (c - 'a'); // lowercase -> uppercase
    return 0; // space / unknown
}

//  Ticker history ring buffer
#define TICKER_MAX  64      // max characters stored in history

typedef struct {
    char  buf[TICKER_MAX];
    int   head;             // index of oldest character
    int   count;            // number of valid characters
} TickerBuf;

static TickerBuf ticker;

static inline void ticker_init(void) {
    memset(&ticker, 0, sizeof(ticker));
}

// Push a new detected character into the ring buffer
static inline void ticker_push(char c) {
    int tail = (ticker.head + ticker.count) % TICKER_MAX;
    ticker.buf[tail] = c;
    if (ticker.count < TICKER_MAX) {
        ticker.count++;
    } else {
        // overwrite oldest
        ticker.head = (ticker.head + 1) % TICKER_MAX;
    }
}

// Get character at logical position i (0 = oldest)
static inline char ticker_get(int i) {
    return ticker.buf[(ticker.head + i) % TICKER_MAX];
}

