// Libraries
# include <stdio.h>
# include "../project_M1_bsp/system.h"
# include "../project_M1_bsp/HAL/inc/alt_types.h"
# include "../project_M1_bsp/drivers/inc/altera_avalon_pio_regs.h"
# include "../project_M1_bsp/drivers/inc/altera_up_avalon_accelerometer_spi.h"

# define ACCEL_PRIORITY 0
# define ACCEL_STACKSIZE 2048

int accel_main(void) {
    alt_up_accelerometer_spi_dev *accel;
    alt_32 x, y, z;

    accel = alt_up_accelerometer_spi_open_dev("/dev/accelerometer_spi_0");
    if (!accel) {
        printf("[ACCEL] Failed to open device.\n");
        return -1;
    }

    printf("[ACCEL] Device initialized\n");

    while (1) {
        alt_up_accelerometer_spi_read_x_axis(accel, &x);
        alt_up_accelerometer_spi_read_y_axis(accel, &y);
        alt_up_accelerometer_spi_read_z_axis(accel, &z);
		printf("X=%ld Y=%ld Z=%ld\n", x, y, z);

		// delay between prints
        volatile int i;
        for (i = 0; i < 2000000; i++);
    }

    return 0;
}
