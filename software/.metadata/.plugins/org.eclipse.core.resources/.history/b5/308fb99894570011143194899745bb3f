// frame buffer dimensions
#define FB_WIDTH  320
#define FB_HEIGHT 240
#define FB_SIZE   (FB_WIDTH * FB_HEIGHT)

// sdram buffer address for emergency stop
#define EMERGENCY_FB_ADDR  0x3DA000
static uint16_t *emergency_fb = (uint16_t *)EMERGENCY_FB_ADDR;

#define TILT_TIMER 10

// task config
#define VGA_STACKSIZE 16384
#define VGA_PRIORITY  2
OS_STK vga_stk[VGA_STACKSIZE];

// shared variable: set by whichever task receives Grove AI data, 0x00 = no new data
volatile char ai_detected_char = 0x00;

// write_pixel()
void write_pixel(unsigned int addr, uint16_t color) {
    IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_ADDR_BASE, addr);
    IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_DATA_BASE, color & 0xFFF);
    IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_WREN_BASE, 1);
    IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_WREN_BASE, 0);
}

// write_emergency()
static void write_emergency(void) {
    unsigned int i;
    for (i = 0; i < FB_SIZE; i++)
        write_pixel(i, emergency_fb[i]);
}

// clear_framebuffer()
static void clear_framebuffer(void) {
    unsigned int i;
    for (i = 0; i < FB_SIZE; i++)
        write_pixel(i, 0x0);
}

// FPS tracking
static uint32_t last_fps_time = 0;
static int      frame_count   = 0;

static uint32_t get_time_ms(void) {
    return IORD_ALTERA_AVALON_PIO_DATA(US_COUNTER_BASE) / 1000;
}

void fps_tick(void) {
    frame_count++;
    uint32_t now = get_time_ms();
    if (now - last_fps_time >= 1000) {
        printf("[VGA] FPS: %d\n", frame_count);
        frame_count   = 0;
        last_fps_time = now;
    }
}

// vga_task()
int game_active = 0;
void vga_task(void *pdata) {
    int cpu_timer = 0;

    printf("[VGA] Start task\n");

    memcpy(emergency_fb, emergency_image_data, IMG_BYTES);
    printf("[VGA] Emergency image ready in SDRAM (%d bytes).\n", IMG_BYTES);

    clear_framebuffer();

    // write sim string to SDRAM once at startup, before the while loop
    static const char sim_capture[] = "ATTACK";
    int i;
	for (i = 0; i < (int)sizeof(sim_capture); i++)
		CAPTURE_TEXT[i] = sim_capture[i];
	printf("[VGA] Sim capture preloaded: %s\n", sim_capture);

    printf("[VGA] Ready.\n");

    while (1) {

        if (emergency_flag) {
            printf("\n[VGA] EMERGENCY STOP\n");
            write_emergency();
            while (emergency_flag) OSTimeDly(5);
            key_flags        = 0;
            ai_detected_char = 0x00;
            // restore previous mode display
            if (game_active) {
                game_draw_map();
                game_draw_status();
            } else {
                clear_framebuffer();
            }
            printf("[VGA] EMERGENCY CLEARED\n\n");
        }

        // KEY0: clears screen and plays mario theme
        if (key_flags & (1 << 0)) {
            key_flags &= ~(1 << 0);
            banner_visible = 0;
            ticker_init();
            marquee_pixel_offset = -(FB_WIDTH);
            clear_framebuffer();
            banner_dirty = 1;
        }

        // KEY1:
        //   - in game mode  - restart game
		//   - idle          - start game
        if (key_flags & (1 << 1)) {
            key_flags &= ~(1 << 1);
			ticker_init();
            if (game_active) {
				// restart game
				banner_visible = 1;
				marquee_pixel_offset = -(FB_WIDTH);
				marquee_accumulator  = 0;
				banner_dirty = 1;
				printf("[VGA] Game restart\n");
				game_init();
				game_draw_map();
				game_draw_status();
			} else {
				// start game
				game_active = 1;
				banner_visible = 1;
				marquee_pixel_offset = -(FB_WIDTH);
				marquee_accumulator  = 0;
				banner_dirty = 1;
				printf("[VGA] Game started\n");
				game_init();
				game_draw_map();
				game_draw_status();
			}
        }

        if (game_active) {
            // game_tick handles tilt via its own game_tilt_timer
            // and camera input via ai_detected_char — no conflict with text mode
            game_tick();
        }

        cpu_timer++;
        if (cpu_timer >= CPU_USAGE_SPEED) {
            cpu_timer = 0;
            CPU_USAGE_CORE2 = (int)OSCPUUsage;
        }

        OSTimeDly(5);
    }
}

// vga_init()
void vga_init(void) {
    OSTaskCreateExt(vga_task,
                    NULL,
                    &vga_stk[VGA_STACKSIZE - 1],
                    VGA_PRIORITY,
                    VGA_PRIORITY,
                    vga_stk,
                    VGA_STACKSIZE,
                    NULL,
                    0);
}

// audio_led_task — handles sfx_tick and LED patterns non-blocking
#define TRAFFIC_LED_BASE CORE_2_TRAFFIC_LED_BASE
#define AUDIO_LED_STACKSIZE 2048
#define AUDIO_LED_PRIORITY  4   // lower priority than VGA (2)
OS_STK audio_led_stk[AUDIO_LED_STACKSIZE];

// Replace the blocking flash_led with a request flag
volatile int led_flash_request = 0;  // set to LED color, task clears it
#define BLINK_ON_TICKS  50
#define BLINK_OFF_TICKS 50
#define BLINK_TIMES     2

static void audio_led_task(void *pdata) {
    int led_timer = 0;
    int active_led = 0;
    int blink_count = 0;
	int led_on      = 0;

    while (1) {
        // handle LED flash request
        if (led_flash_request && !active_led) {
            active_led = led_flash_request;
            led_flash_request = 0;
            led_timer = 0;
            led_on = 1;
            blink_count = 0;
            IOWR_ALTERA_AVALON_PIO_DATA(TRAFFIC_LED_BASE, active_led);
        }

        if (active_led) {
            led_timer++;
            if (led_on && led_timer >= BLINK_ON_TICKS) {
                led_timer  = 0;
                led_on = 0;
                IOWR_ALTERA_AVALON_PIO_DATA(TRAFFIC_LED_BASE, 0);
            } else if (!led_on && led_timer >= BLINK_OFF_TICKS) {
            	led_timer = 0;
            	blink_count++;
            	if (blink_count >= BLINK_TIMES) {
            		active_led = 0;
            	} else {
            		led_on = 1;
            		IOWR_ALTERA_AVALON_PIO_DATA(TRAFFIC_LED_BASE, active_led);
            	}
            }
        }

        sfx_tick(5);
        OSTimeDly(5);
    }
}

// audio_led_init()
void audio_led_init(void) {
    OSTaskCreateExt(audio_led_task,
                    NULL,
                    &audio_led_stk[AUDIO_LED_STACKSIZE - 1],
					AUDIO_LED_PRIORITY,
					AUDIO_LED_PRIORITY,
					audio_led_stk,
					AUDIO_LED_STACKSIZE,
                    NULL,
                    0);
}
