// Call from vga_task every loop iteration when game_active == 1.
// Handles tilt movement, camera input, state transitions.
// tilt_flag and ai_detected_char are read from interrupts.h globals.

static int  game_tilt_timer   = 0;
#define     GAME_TILT_DELAY   80    // ticks between tilt-triggered moves
static int  game_chest_timer  = 0;
#define     GAME_CHEST_SHOW   60   // ticks to display chest message

static void game_tick(void) {
	// command input — triggered by capture_flag, reads full word from CAPTURE_TEXT
	if (capture_flag) {
		capture_flag = 0;

		// read command from SDRAM
		char cmd[16] = {0};
		int  ci = 0;
		while (ci < 15 && CAPTURE_TEXT[ci] != '\0') {
			cmd[ci] = CAPTURE_TEXT[ci];
			ci++;
		}

		printf("[GAME] Command received: %s\n", cmd);

		// also load into ticker banner as before
		ticker_init();
		for (ci = 0; cmd[ci] != '\0'; ci++)
			ticker_push(cmd[ci]);
		marquee_pixel_offset = -(FB_WIDTH);

		if (game_active) {
			int result = game_handle_command(cmd);
			if (status_is_dirty()) {
				game_draw_status();
				status_snapshot();
			}
			if (result > 0) game_draw_map();
		}
	}

    // per-state logic
    switch (game_state) {

        case GAME_PLAYING: {
            int tilt = tilt_flag;

            if (tilt == TILT_LEFT || tilt == TILT_RIGHT ||
                tilt == TILT_FORWARD || tilt == TILT_BACKWARD) {
                game_tilt_timer++;
                if (game_tilt_timer >= GAME_TILT_DELAY) {
                    game_tilt_timer = 0;
                    int dc = 0, dr = 0;
                    if      (tilt == TILT_LEFT)     dc = -1;
                    else if (tilt == TILT_RIGHT)     dc = +1;
                    else if (tilt == TILT_FORWARD)   dr = -1;
                    else if (tilt == TILT_BACKWARD)  dr = +1;

                    move_player_smooth(dc, dr);

                    if (status_is_dirty()) {
                    	game_draw_status();
                    	status_snapshot();
                    }
                }
            } else {
                game_tilt_timer = 0;
            }
            break;
        }

        case GAME_CHEST:
            game_chest_timer++;
            if (game_chest_timer >= GAME_CHEST_SHOW) {
                game_chest_timer = 0;
                game_state = GAME_PLAYING;
                game_draw_status();
                status_snapshot();
            }
            break;

        case GAME_NEXT_FLOOR:
            // brief pause then load next floor
            game_chest_timer++;
            if (game_chest_timer >= GAME_CHEST_SHOW) {
                game_chest_timer = 0;
                game_load_floor(player.floor + 1);
                game_state = GAME_PLAYING;
                game_draw_map();
                game_draw_status();
                status_snapshot();
            }
            break;

        case GAME_OVER:
        case GAME_WIN:

        default:
            break;
    }
}

