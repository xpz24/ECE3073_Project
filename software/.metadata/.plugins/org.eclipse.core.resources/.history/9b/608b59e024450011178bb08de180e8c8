// libraries
#include <stdio.h>
#include "../project_M2_core1_bsp/system.h"
#include "../project_M2_core1_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../project_M2_core1_bsp/HAL/inc/sys/alt_irq.h"

// base addresses
#define KEY_BASE CORE_1_KEY_BASE
#define SW_BASE CORE_1_SW_BASE
#define TX_BASE CORE_1_TX_BASE
#define RX_BASE CORE_1_RX_BASE

// flags
volatile uint32_t key_flags = 0;

// key interrupts
static void key1_irq_handler(void* context, alt_u32 id) {
	uint32_t edge = IORD_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE);

    // clear edge capture for KEY1 PIO
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE, 0);

    // store which key(s) triggered
    key_flags |= edge;

    // notify cpu 1
    IOWR_ALTERA_AVALON_PIO_DATA(TX_BASE, edge);
}

void init_key1_irq()
{
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE, 0);

    IOWR_ALTERA_AVALON_PIO_IRQ_MASK(KEY_BASE, 0xF);

    alt_irq_register(CORE_1_KEY_IRQ, NULL, key1_irq_handler);
}
