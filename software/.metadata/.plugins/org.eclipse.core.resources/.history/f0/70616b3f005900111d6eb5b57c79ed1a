// Enemy tracking — store positions so ATTACK can find nearest to player
#define MAX_ENEMIES 8
typedef struct {
    int col;
    int row;
    int alive;
} EnemyInfo;

static EnemyInfo cur_enemies[MAX_ENEMIES];
static int       enemy_count = 0;

typedef enum {
    GAME_TITLE,         // title screen
    GAME_PLAYING,       // normal gameplay
    GAME_WAIT_CAMERA,   // paused, waiting for camera input to unlock door
    GAME_CHEST,         // showing chest reward message
    GAME_NEXT_FLOOR,    // transitioning to next floor
    GAME_OVER,          // player died
    GAME_WIN            // all floors cleared
} GameState;

typedef struct {
    int col;            // current tile column
    int row;            // current tile row
    int hp;             // current health points
    int hp_max;         // maximum health points
    int keys;           // number of keys held
    int score;          // score
    int floor;          // current floor index (0-based)
} Player;

// Runtime copy of current floor map (mutable — doors open, items collected)
static uint8_t  cur_map[MAP_ROWS][MAP_COLS];
static DoorInfo cur_doors[MAX_DOORS];
static Player   player;
static GameState game_state = GAME_TITLE;

// which door index the player is currently trying to unlock (-1 = none)
static int pending_door = -1;

static void game_load_floor(int floor_idx) {
    int r, c, d;
    const uint8_t (*src)[MAP_COLS] = (const uint8_t (*)[MAP_COLS])floor_maps[floor_idx];
    for (r = 0; r < MAP_ROWS; r++)
        for (c = 0; c < MAP_COLS; c++)
            cur_map[r][c] = src[r][c];

    for (d = 0; d < MAX_DOORS; d++)
        cur_doors[d] = floor_doors[floor_idx][d];

    // scan map for enemies and register them
    enemy_count = 0;
    for (r = 0; r < MAP_ROWS && enemy_count < MAX_ENEMIES; r++) {
        for (c = 0; c < MAP_COLS && enemy_count < MAX_ENEMIES; c++) {
            if (cur_map[r][c] == TILE_ENEMY) {
                cur_enemies[enemy_count].col   = c;
                cur_enemies[enemy_count].row   = r;
                cur_enemies[enemy_count].alive = 1;
                enemy_count++;
            }
        }
    }

    player.col   = floor_start_col[floor_idx];
    player.row   = floor_start_row[floor_idx];
    player.floor = floor_idx;
}

static void game_init(void) {
    player.hp     = 5;
    player.hp_max = 5;
    player.keys   = 0;
    player.score  = 0;
    player.floor  = 0;
    game_state    = GAME_PLAYING;
    pending_door  = -1;
    game_load_floor(0);
}

// traffic led
#define GREEN_LED     4
#define YELLOW_LED    2
#define RED_LED       1

// CAMERA INPUT HANDLER
// Returns: 1 = door opened (redraw map), 2 = enemy killed (redraw map), 0 = nothing
static int game_handle_command(const char *cmd) {

    // UNLOCK — opens the nearest pending door
    if (strncmp(cmd, "UNLOCK", 6) == 0) {
        if (game_state == GAME_WAIT_CAMERA && pending_door >= 0) {
            cur_map[cur_doors[pending_door].row][cur_doors[pending_door].col] = TILE_EMPTY;
            cur_doors[pending_door].open = 1;
            player.score += 20;
            pending_door = -1;
            game_state   = GAME_PLAYING;
            sfx_door_open();
            request_led_flash(GREEN_LED);
            return 1;
        }
        return 0;
    }

    // ATTACK — kills the enemy nearest to the player
    if (strncmp(cmd, "ATTACK", 6) == 0) {
        if (game_state != GAME_PLAYING) return 0;
        int best = -1, best_dist = 9999;
        int i;
        for (i = 0; i < enemy_count; i++) {
            if (!cur_enemies[i].alive) continue;
            int dr = cur_enemies[i].row - player.row;
            int dc = cur_enemies[i].col - player.col;
            int dist = (dr < 0 ? -dr : dr) + (dc < 0 ? -dc : dc);
            if (dist < best_dist) {
                best_dist = dist;
                best      = i;
            }
        }
        if (best >= 0 && best_dist <= 2) {
            cur_enemies[best].alive = 0;
            cur_map[cur_enemies[best].row][cur_enemies[best].col] = TILE_EMPTY;
            player.score += 30;   // coins for killing enemy
            sfx_coin_pickup();
            request_led_flash(YELLOW_LED);
            return 2;
        }
        return 0;
    }

    return 0;
}

// PLAYER MOVEMENT
// Returns 1 if move was accepted (or triggered an event), 0 if blocked.
static int game_move(int dcol, int drow) {
    if (game_state != GAME_PLAYING) return 0;

    int nc = player.col + dcol;
    int nr = player.row + drow;

    if (nc < 0 || nc >= MAP_COLS || nr < 0 || nr >= MAP_ROWS) return 0;

    uint8_t tile = cur_map[nr][nc];

    // --- wall: blocked
    if (tile == TILE_WALL) return 0;

    // --- door: check for key or camera input
    if (tile == TILE_DOOR) {
        int d, door_open = 0;
        for (d = 0; d < MAX_DOORS; d++) {
            if (cur_doors[d].col == nc && cur_doors[d].row == nr) {
                if (cur_doors[d].open) { door_open = 1; break; }
                if (player.keys > 0) {
                    player.keys--;
                    cur_doors[d].open = 1;
                    cur_map[nr][nc]   = TILE_EMPTY;
                    door_open = 1;
                    sfx_door_open();
                    break;
                }
                // need camera input
                pending_door = d;
                game_state   = GAME_WAIT_CAMERA;
                return 1;
            }
        }
        if (!door_open) return 0; // still locked
    }

    // --- enemy: blocked if alive
    if (tile == TILE_ENEMY) {
    	// check if it's actually still alive in our enemy list
    	int i;
    	for (i = 0; i < enemy_count; i++) {
    		if (cur_enemies[i].col == nc && cur_enemies[i].row == nr && cur_enemies[i].alive) {
    			// take damage on contact
				player.hp--;
    			printf("[GAME] Enemy contact! HP now %d\n", player.hp);
				sfx_damage();
				request_led_flash(RED_LED);
				if (player.hp <= 0) {
					game_state = GAME_OVER;
					sfx_game_over();
				}
				return 1;  // move blocked but damage applied
    		}
    	}
    	// dead enemy tile somehow still in map - treat as floor
    }

    // snapshot tile before moving so landing events read correct value
    uint8_t landing_tile = cur_map[nr][nc];

    // --- move accepted
    player.col = nc;
    player.row = nr;

    // --- landing events
    switch (landing_tile) {
        case TILE_CHEST:
            player.score += 50;
            cur_map[nr][nc] = TILE_EMPTY;
            sfx_coin_pickup();
            game_state = GAME_CHEST;
            request_led_flash(YELLOW_LED);
            break;
        case TILE_KEY:
            player.keys++;
            cur_map[nr][nc] = TILE_EMPTY;
            sfx_key_pickup();
            request_led_flash(YELLOW_LED);
            break;
        case TILE_TRAP:
            player.hp--;
            sfx_damage();
            if (player.hp <= 0) {
            	game_state = GAME_OVER;
            	sfx_game_over();
            }
            request_led_flash(RED_LED);
            break;
        case TILE_EXIT:
            if (player.floor + 1 < NUM_FLOORS)
                game_state = GAME_NEXT_FLOOR;
            else
                game_state = GAME_WIN;
            sfx_next_floor();
            request_led_flash(GREEN_LED);
            break;
        default:
            break;
    }

    return 1;
}

