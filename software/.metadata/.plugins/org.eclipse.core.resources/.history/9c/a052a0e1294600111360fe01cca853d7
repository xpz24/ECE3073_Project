// libraries
#include <stdio.h>
#include "../M2_core1_bsp/system.h"
#include "../M2_core1_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../M2_core1_bsp/HAL/inc/sys/alt_irq.h"

// base addresses
#define KEY_BASE CORE_1_KEY_BASE
#define TX_BASE CORE_1_TX_BASE
#define RX_BASE CORE_1_RX_BASE

// flags
volatile int key_flags = 0;

// key interrupts
static void key_irq_handler(void* context, alt_u32 id) {
	int edge = IORD_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE);

    // clear edge capture for KEY1 PIO
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE, 0);

    // store which key(s) triggered
    key_flags |= edge;

    // notify cpu 1
//    IOWR_ALTERA_AVALON_PIO_DATA(TX_BASE, edge);
}

void init_key_irq(void) {
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE, 0);
    IOWR_ALTERA_AVALON_PIO_IRQ_MASK(KEY_BASE, 0xF);
    alt_irq_register(CORE_1_KEY_IRQ, NULL, key_irq_handler);
    alt_irq_enable_all(1);
}

// spi interrupts
// esp32 ready interrupt handler
static void esp32_irq_handler(void* context, alt_u32 id) {
    int edge = IORD_ALTERA_AVALON_PIO_EDGE_CAP(CORE_1_ESP32_READY_BASE);
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(CORE_1_ESP32_READY_BASE, 0xFFFFFFFF);
    if (edge) {
        esp32_ready_flag = 1;
        printf("[IRQ] ESP32 data ready signal received.\n");
    }
}

void init_esp32_irq(void) {
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(CORE_1_ESP32_READY_BASE, 0xFFFFFFFF);
    IOWR_ALTERA_AVALON_PIO_IRQ_MASK(CORE_1_ESP32_READY_BASE, 0x1);  // only 1 pin
    alt_irq_register(CORE_1_ESP32_READY_IRQ, NULL, esp32_irq_handler);
    alt_irq_enable_all(1);
}
