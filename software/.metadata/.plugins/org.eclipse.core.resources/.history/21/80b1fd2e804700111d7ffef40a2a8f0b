// libraries
#include <stdio.h>
#include "../M2_core3_bsp/system.h"
#include "../M2_core3_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../M2_core3_bsp/HAL/inc/sys/alt_irq.h"
#include "interrupts.h"
#include "../M2_core3_bsp/HAL/inc/includes.h"

// base addresses
#define KEY_BASE     CORE_3_KEY_BASE
#define TX_3_1_BASE  CORE_3_1_TX_BASE
#define RX_3_1_BASE  CORE_3_1_RX_BASE

// incoming flags
#define EMERGENCY_FLAG  0x1

// flags
volatile int key_flags = 0;
volatile int emergency_flag = 0;

// key interrupts
static void key_irq_handler(void* context, alt_u32 id) {
	int edge = IORD_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE);
    // clear edge capture for KEY1 PIO
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE, 0);
    // store which key(s) triggered
    key_flags |= edge;
}

void init_key_irq(void) {
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(KEY_BASE, 0);
    IOWR_ALTERA_AVALON_PIO_IRQ_MASK(KEY_BASE, 0xF);
    alt_irq_register(CORE_3_KEY_IRQ, NULL, key_irq_handler);
    alt_irq_enable_all(1);
}

// pulse tx to notify cpu1
void tx_pulse(alt_u32 flag)
{
    IOWR_ALTERA_AVALON_PIO_DATA(TX_3_1_BASE, flag);
    OSTimeDly(2);                               /* hold the line    */
    IOWR_ALTERA_AVALON_PIO_DATA(TX_3_1_BASE, 0); /* pull back down */
}

static void rx_irq_handler(void *context, alt_u32 id)
{
    int val = IORD_ALTERA_AVALON_PIO_EDGE_CAP(RX_3_1_BASE) & 0x7;
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(RX_3_1_BASE, 0);

    // decode incoming RX pulse into key_flags bits
    if (val & EMERGENCY_FLAG)
        emergency_flag |= (1 << 0);   // maps to "CAPTURING IMAGE"
}

void init_rx_irq(void)
{
    IOWR_ALTERA_AVALON_PIO_EDGE_CAP(RX_3_1_BASE, 0);
    IOWR_ALTERA_AVALON_PIO_IRQ_MASK(RX_3_1_BASE, 0x7);
    alt_irq_register(CORE_3_1_RX_IRQ, NULL, rx_irq_handler);
    alt_irq_enable_all(1);
}
