	OSTaskCreateExt(idle_task,
					NULL,
					(void*)&idle_stk[IDLE_STACKSIZE-1],
					IDLE_PRIORITY,
					IDLE_PRIORITY,
					idle_stk,
					IDLE_STACKSIZE,
					NULL,
					0);
	printf("Tick count before start: %lu\n", OSTimeGet());

	OSStart();
	return 0;
}
