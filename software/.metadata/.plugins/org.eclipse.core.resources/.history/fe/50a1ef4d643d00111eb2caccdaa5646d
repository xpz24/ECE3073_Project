// parameters
#define ACCEL_PRIORITY 4
#define ACCEL_STACKSIZE 2048

OS_STK accel_stk[ACCEL_STACKSIZE];

#define IDLE_PRIORITY 10
#define IDLE_STACKSIZE 512
OS_STK idle_stk[IDLE_STACKSIZE];

void idle_task(void* pdata) {
    while (1) {
    	printf('a\n')
        OSTimeDlyHMSM(0, 0, 0, 100);
    }
}

// accel task
void accel_task(void* pdata) {
	alt_up_accelerometer_spi_dev *accel = alt_up_accelerometer_spi_open_dev("/dev/accelerometer_spi_0");
	if (!accel) {
		printf("[ACCEL] Failed to open device.\n");
		return;
	}
	else {
		printf("[ACCEL] Device initialized.\n");
	}

	char output[64];
	alt_32 x, y, z;

	// continuously read axis data
	while (1) {
		alt_up_accelerometer_spi_read_x_axis(accel, &x);
		alt_up_accelerometer_spi_read_y_axis(accel, &y);
		alt_up_accelerometer_spi_read_z_axis(accel, &z);

		sprintf(output, "[ACCEL] X=%ld Y=%ld Z=%ld\n", x, y, z);
		printf("%s",output);

		OSTimeDlyHMSM(0, 0, 1, 0);
//		for (volatile int i = 0; i < 100000; i++);
	}
}

// accel main function
int accel_main(void) {
	OSInit();
