// libraries
#include <stdio.h>
#include "../M2_core1_bsp/system.h"
#include "../M2_core1_bsp/HAL/inc/alt_types.h"
#include "../M2_core1_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../M2_core1_bsp/drivers/inc/altera_up_avalon_accelerometer_spi.h"
#include "../M2_core1_bsp/HAL/inc/includes.h"
#include "../M2_core1_bsp/HAL/inc/io.h"
#include "interrupts.h"

// definitions
#define ACCEL_PRIORITY    2
#define ACCEL_STACKSIZE   4096
OS_STK accel_stk[ACCEL_STACKSIZE];

#define UPSIDE_DOWN_THRESH  (-200)
#define UPRIGHT_THRESH      ( 200)
#define STABLE_COUNT        5

int stable = 0;

#define TX_1_2_BASE    CORE_1_2_TX_BASE
#define TX_1_3_BASE    CORE_1_3_TX_BASE
#define COUNTER_BASE   US_COUNTER_BASE

#define EMERGENCY_START   0x1
#define EMERGENCY_STOP    0x2

volatile int emergency_active;

// tilting for scrolling text
#define TILT_THRESHOLD  150
#define TILT_NORMAL     0x4
#define TILT_RIGHT      0x8
#define TILT_LEFT       0xC
#define TILT_STABLE_COUNT 3

// read current microsecond count
static inline alt_u32 get_us(void) {
    return IORD_ALTERA_AVALON_PIO_DATA(COUNTER_BASE);
}

// accel task
void accel_task(void* pdata) {
	alt_up_accelerometer_spi_dev *accel;
	alt_32 x, y, z;

	accel = alt_up_accelerometer_spi_open_dev(CORE_1_ACCELEROMETER_NAME);
	if (!accel) {
		printf("[ACCEL] Failed to open device.\n");
		while (1);
	}
	printf("[ACCEL] Device initialized.\n");

	alt_u32 start = 0;
	alt_u32 end = 0;

	alt_u32 last_tilt_dir = TILT_NORMAL;
	int tilt_stable = 0;

	// continuously read axis data
	while (1) {
		alt_up_accelerometer_spi_read_x_axis(accel, &x);
		alt_up_accelerometer_spi_read_y_axis(accel, &y);
		alt_up_accelerometer_spi_read_z_axis(accel, &z);

		// if emergency not active
		if (!emergency_active) {
			// check for emergency
			if (z < UPSIDE_DOWN_THRESH) {
				stable++;
				if (stable >= STABLE_COUNT) {
					emergency_active = 1;
					// notify core 2
					start = get_us();
					tx_pulse(TX_1_2_BASE, EMERGENCY_START);
					end = get_us();
					printf("\n[LATENCY] Start Emergency Core 2 TX pulse: %lu us\n", end - start);
					// notify core 3
					start = get_us();
					tx_pulse(TX_1_3_BASE, EMERGENCY_START);
					end = get_us();
					printf("[LATENCY] Start Emergency Core 3 TX pulse: %lu us\n\n", end - start);
					printf("[ACCEL] X=%ld Y=%ld Z=%ld\n", x, y, z);
					printf("[ACCEL] EMERGENCY: Board upside down!\n");
				}
			}
			else {
				stable = 0; // reset if reading doesnt hold
			}
			// determine tilt
			alt_u32 tilt_dir;
			if      (x >  TILT_THRESHOLD) tilt_dir = TILT_RIGHT;
			else if (x < -TILT_THRESHOLD) tilt_dir = TILT_LEFT;
			else                          tilt_dir = TILT_NORMAL;
			// read-modify-write: preserve emergency bits [1:0], update tilt bits [3:2]
			// only write PIO if direction changed
			if (tilt_dir != last_tilt_dir) {
				tilt_stable++;
				if (tilt_stable >= TILT_STABLE_COUNT) {
					tx_pulse();
				}
			}
			else {
				tilt_stable = 0;
			}
		}
		// if emergency active
		else {
			if (z > UPRIGHT_THRESH) {
				stable++;
				if (stable >= STABLE_COUNT && emergency_clear) {
					emergency_active = 0;
					// notify core 2
					start = get_us();
					tx_pulse(TX_1_2_BASE, EMERGENCY_STOP);
					end = get_us();
					printf("\n[LATENCY] Clear Emergency Core 2 TX pulse: %lu us\n", end - start);
					// notify core 3
					start = get_us();
					tx_pulse(TX_1_3_BASE, EMERGENCY_STOP);
					end = get_us();
					printf("[LATENCY] Clear Emergency Core 3 TX pulse: %lu us\n\n", end - start);
					printf("[ACCEL] X=%ld Y=%ld Z=%ld\n", x, y, z);
					printf("[ACCEL] Board upright, resuming.\n");
				}
			}
			else {
				stable = 0;
			}
		}
		OSTimeDly(10);
	}
}

// accel_init
void accel_init(void) {
    OSTaskCreateExt(accel_task,
                    NULL,
                    (void*)&accel_stk[ACCEL_STACKSIZE-1],
                    ACCEL_PRIORITY,
					ACCEL_PRIORITY,
                    accel_stk,
                    ACCEL_STACKSIZE,
                    NULL,
                    0);
}
