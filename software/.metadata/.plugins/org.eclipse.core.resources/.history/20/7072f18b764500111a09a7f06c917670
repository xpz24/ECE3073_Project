		if (key_flags & (1 << 0)) {
			key_flags &= ~(1 << 0);
			printf("[TEST] Requesting data...\n");
			test_esp_communication();
		}
		if (key_flags & (1 << 1)) {
			key_flags &= ~(1 << 1);
			printf("\n[CAPTURE] Starting capture sequence...\n");
