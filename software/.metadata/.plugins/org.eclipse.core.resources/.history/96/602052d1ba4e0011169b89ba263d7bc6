// libraries
#include <stdio.h>
#include <string.h>
#include "../M2_core2_bsp/system.h"
#include "../M2_core2_bsp/drivers/inc/altera_avalon_pio_regs.h"
#include "../M2_core2_bsp/HAL/inc/includes.h"
#include "../M2_core2_bsp/HAL/inc/io.h"
#include "interrupts.h"
#include "image_data.h"
#include "vga_text_render.h"

// base addresses
#define PIXEL_ADDR_BASE CORE_2_PIXEL_ADDR_BASE
#define PIXEL_DATA_BASE CORE_2_PIXEL_DATA_BASE
#define PIXEL_WREN_BASE CORE_2_PIXEL_WREN_BASE
#define SDRAM_BASE SHARED_SDRAM_BASE

// CPU usages
#define CPU_USAGE_CORE1_OFFSET  0x100
#define CPU_USAGE_CORE2_OFFSET  0x104
#define CPU_USAGE_CORE3_OFFSET  0x108

#define CPU_USAGE_CORE1  (*(volatile int*)(SDRAM_BASE + CPU_USAGE_CORE1_OFFSET))
#define CPU_USAGE_CORE2  (*(volatile int*)(SDRAM_BASE + CPU_USAGE_CORE2_OFFSET))
#define CPU_USAGE_CORE3  (*(volatile int*)(SDRAM_BASE + CPU_USAGE_CORE3_OFFSET))

// frame buffer dimensions
#define FB_WIDTH  320
#define FB_HEIGHT 240
#define FB_SIZE   (FB_WIDTH * FB_HEIGHT)

// sdram buffer address for emergency stop
#define EMERGENCY_FB_ADDR  0x3DA000
static uint16_t *emergency_fb = (uint16_t *)EMERGENCY_FB_ADDR;

// timer for tilt
int tilt_timer = 0;
#define TILT_TIMER 10
int scroll_timer = 0;
#define SCROLL_SPEED 10

// task config
#define VGA_STACKSIZE 4096
#define VGA_PRIORITY  2
OS_STK vga_stk[VGA_STACKSIZE];

// shared variable: set by whichever task receives Grove AI data, 0x00 = no new data
volatile char ai_detected_char = 0x00;

// write_pixel()
void write_pixel(unsigned int addr, uint16_t color) {
	IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_ADDR_BASE, addr);
	IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_DATA_BASE, color & 0xFFF);
	IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_WREN_BASE, 1);
	IOWR_ALTERA_AVALON_PIO_DATA(PIXEL_WREN_BASE, 0);
}

// write_emergency()
static void write_emergency(void) {
    unsigned int i;
    for (i = 0; i < FB_SIZE; i++)
        write_pixel(i, emergency_fb[i]);
}

// clear_framebuffer()
static void clear_framebuffer(void) {
    unsigned int i;
    for (i = 0; i < FB_SIZE; i++)
        write_pixel(i, 0x0);
}

// FPS tracking
static uint32_t last_fps_time = 0;
static int      frame_count   = 0;

static uint32_t get_time_ms(void) {
    // us_counter counts in microseconds, divide by 1000 for ms
    return IORD_ALTERA_AVALON_PIO_DATA(US_COUNTER_BASE) / 1000;
}

void fps_tick(void) {
    frame_count++;
    uint32_t now = get_time_ms();
    if (now - last_fps_time >= 1000) {
        printf("[VGA] FPS: %d\n", frame_count);
        frame_count   = 0;
        last_fps_time = now;
    }
}

// vga_task()
void vga_task(void *pdata) {
    printf("[VGA] Start task\n");

    memcpy(emergency_fb, emergency_image_data, IMG_BYTES);
    printf("[VGA] Emergency image ready in SDRAM (%d bytes).\n", IMG_BYTES);

    clear_framebuffer();

    int display_active = 0;
    int last_tilt = TILT_NORMAL;

    printf("[VGA] Ready.\n");

    static const char test_chars[] = "PLAY MARIO";
    int test_idx   = 0;
    int test_timer = 0;

    while (1) {
        // emergency
        if (emergency_flag) {
            printf("\n[VGA] EMERGENCY STOP\n");
            write_emergency();
            while (emergency_flag) OSTimeDly(5);
            key_flags = 0;
            ai_detected_char = 0x00;
            if (display_active) vga_text_init();
            else clear_framebuffer();
            printf("[VGA] EMERGENCY CLEARED\n\n");
        }

        // KEY0 clears screen
        if (key_flags & (1 << 0)) {
            key_flags &= ~(1 << 0);
            display_active = 0;
            last_tilt = TILT_NORMAL;
            printf("[VGA] Cleared\n");
            clear_framebuffer();
        }

        // KEY1 activates text display
        if (key_flags & (1 << 1)) {
            key_flags &= ~(1 << 1);
            display_active = 1;
            last_tilt = TILT_NORMAL;
            printf("[VGA] Text mode on\n");
            vga_text_init();
            test_idx = 0;
        }

        // dispaly is active
        if (display_active) {
            // test char injection
            test_timer++;
            if (test_timer >= 20 && test_idx < (int)(sizeof(test_chars) - 1)) {
                test_timer = 0;
                ai_detected_char = test_chars[test_idx];
                test_idx++;
            }

            // new character from Grove AI
            char c = ai_detected_char;
            if (c != 0x00) {
                ai_detected_char = 0x00;
                vga_text_update(c);  // dirty redraw, fast
            }

            // scroll timer
//            scroll_timer++;
//            if (scroll_timer >= SCROLL_SPEED) {
//            	scroll_timer = 0;
//            	draw_marquee_tick();
//            }
            draw_marquee_tick();

            // tilt scroll
            int tilt = tilt_flag;
            if (tilt == TILT_LEFT || tilt == TILT_RIGHT) {
                tilt_timer++;
                if (tilt_timer >= TILT_TIMER) {
                	printf("%c\n",tilt);
                    tilt_timer = 0;
                    vga_tilt_scroll(tilt == TILT_LEFT ? +1 : -1);
                }
            } else {
                tilt_timer = 0;
            }
            last_tilt = tilt;
        }

        // write cpu usage into sdram
        CPU_USAGE_CORE2 = (int)OSCPUUsage();

        OSTimeDly(1);  // was 10, reduced for smoother updates
    }
}

// vga_init()
void vga_init(void) {
    OSTaskCreateExt(vga_task,
                    NULL,
                    &vga_stk[VGA_STACKSIZE - 1],
                    VGA_PRIORITY,
                    VGA_PRIORITY,
                    vga_stk,
                    VGA_STACKSIZE,
                    NULL,
                    0);
}
